{
  "name": "apistatuscheck-mcp-server",
  "version": "0.1.1",
  "description": "MCP server for checking real-time API and cloud service status via API Status Check",
  "license": "MIT",
  "private": false,
  "type": "module",
  "bin": {
    "apistatuscheck-mcp": "dist/index.js",
    "apistatuscheck-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --max-warnings=0",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "api-status",
    "apistatuscheck",
    "monitoring",
    "cloud-status"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shibley/apistatuscheck-mcp-server"
  },
  "homepage": "https://apistatuscheck.com",
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.shibley/apistatuscheck"
}
